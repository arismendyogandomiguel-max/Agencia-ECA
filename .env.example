# ═══════════════════════════════════════════════════════════════
# ECA — Estudio Creativo Agéntico
# Variables de Entorno — COPIA ESTE ARCHIVO como .env
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── FastAPI Backend ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
API_CORS_ORIGINS=http://localhost:3000,https://eca.alihaned.com
API_DEBUG=false

# ─── Redis (Cola Celery) ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO (S3-compatible para assets de render) ─────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=eca-assets
MINIO_USE_SSL=false

# ─── Inferencia LLM (ALiRouter / LiteLLM) ────────────────────
ALIROUTER_BASE_URL=https://alirouter.alihaned.com
ALIROUTER_API_KEY=CHANGE_ME
ALIROUTER_DEFAULT_MODEL=gpt-4o

# ─── Hermes (Eva) ────────────────────────────────────────────
HERMES_PROFILES_DIR=/opt/data/eca/hermes/profiles
EVA_TELEGRAM_BOT_TOKEN=CHANGE_ME

# ─── Postiz (Social Publisher) ────────────────────────────────
POSTIZ_API_URL=http://postiz:5000
POSTIZ_API_KEY=CHANGE_ME

# ─── Google Workspace (vía MCP) ──────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://eca.alihaned.com/api/auth/google/callback

# ─── Higgsfield AI (Video Cinematográfico) ────────────────────
HIGGSFIELD_API_KEY=CHANGE_ME
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# ─── fal.ai (Generación de Imágenes / Video) ─────────────────
FAL_KEY=CHANGE_ME

# ─── ElevenLabs (Voz Neural) ─────────────────────────────────
ELEVENLABS_API_KEY=CHANGE_ME

# ─── n8n (Automatización) ────────────────────────────────────
N8N_WEBHOOK_URL=https://n8n.alihaned.com/webhook

# ─── Dominio & SSL (Dokploy/Traefik) ─────────────────────────
DOMAIN=eca.alihaned.com
TRAEFIK_NETWORK=dokploy-network
